{
  "name": "story-generator",
  "version": "0.2.0",
  "description": "Multi-agent story creation system",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "release:build": "vite build && electron-builder --publish never",
    "release": "vite build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.storygenerator.app",
    "productName": "Story Generator",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Toukaiteio",
        "repo": "story-generator",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@google/genai": "^1.52.0",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@opentelemetry/api": "^1.10.0",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.469.0",
    "pinia": "^2.3.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "electron-builder-squirrel-windows": "26.18.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "overrides": {
      "undici@^6.0.0": "6.29.1",
      "undici@^7.0.0": "7.30.1",
      "tar@^7.0.0": "7.5.22",
      "form-data@^4.0.0": "4.0.6",
      "js-yaml@^4.0.0": "4.3.2",
      "brace-expansion@^1.0.0": "1.1.21",
      "brace-expansion@^2.0.0": "2.1.7",
      "brace-expansion@^5.0.0": "5.0.12",
      "@xmldom/xmldom@^0.8.0": "0.8.15",
      "@xmldom/xmldom@^0.9.0": "0.9.12",
      "builder-util-runtime@^9.0.0": "9.7.1",
      "postcss@^8.0.0": "8.5.32",
      "source-map-js@^1.0.0": "1.2.2",
      "nanoid@^3.0.0": "3.3.20",
      "browserslist@^4.0.0": "4.29.5",
      "zod@^4.0.0": "4.6.7",
      "basic-ftp@^5.0.0": "6.2.3",
      "ip-address@^10.0.0": "10.7.5",
      "protobufjs@^7.0.0": "7.6.5",
      "postcss-selector-parser@^6.0.0": "6.1.5",
      "electron-builder-squirrel-windows": "26.18.1",
      "app-builder-lib": "26.18.1",
      "dmg-builder": "26.18.1"
    }
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
